# Copy to .env.local and fill in once the Supabase project (shared with
# DPI Dashboard V2) is available. See lib/supabase.ts for how these are used.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client. Used by the admin panel for
# CRUD operations and to bypass RLS where explicitly required.
SUPABASE_SERVICE_ROLE_KEY=
