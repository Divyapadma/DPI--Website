# Copy to .env.local and fill in once the Supabase project exists.
# See lib/supabase.ts for how these are used.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client. Used by the admin panel for
# CRUD operations and to bypass RLS where explicitly required.
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit-hosted hero video (optional). If unset, the hero falls back to
# the placeholder image — see components/home/Hero.tsx. Project/blog
# images are read straight from the DB (full ImageKit URLs), no env var
# needed for those — see lib/imagekit-loader.ts.
NEXT_PUBLIC_HERO_VIDEO_URL=

# Telegram Bot API — sends a notification to this chat whenever a lead form
# (Contact / project enquiry / career application) is submitted. See
# lib/telegram.ts. Optional: if either is unset, submitLead just skips the
# notification silently — the lead still saves to Supabase either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
